server {
    listen 80;
    server_name vault.hjd.ai;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name vault.hjd.ai;

    ssl_certificate /etc/letsencrypt/live/vault.hjd.ai/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vault.hjd.ai/privkey.pem;

    # Frontend — serve built SPA
    root /home/hq/vault/dashboard/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # API proxy — pass through to FastAPI
    location /api/ {
        proxy_pass http://127.0.0.1:3200;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;

        auth_basic "VAULT";
        auth_basic_user_file /etc/nginx/.htpasswd;
    }
}
